# Server-side only. Do not expose these values in browser code.
DIDIT_API_KEY=
DIDIT_ELLIS_WORKFLOW_ID=
ELLIS_DIDIT_REQUEST_TOKEN=

# Browser return URL only; this is not the server-to-server webhook URL.
DIDIT_ELLIS_CALLBACK_URL=https://leah.somasyncai.com/verification-return.html
DIDIT_ELLIS_CUSTOM_DOMAIN=

# Set from the Didit V3 destination and the matching sandbox/live workflow.
DIDIT_ELLIS_WEBHOOK_SECRET=
DIDIT_ELLIS_ENVIRONMENT=sandbox

# Dedicated Apps Script web-app store; never expose the shared token in the browser.
DIDIT_ELLIS_RESULT_STORE_URL=
ELLIS_DIDIT_RESULT_STORE_TOKEN=
